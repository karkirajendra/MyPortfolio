PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password
NODE_ENV=development
# WEB_CONCURRENCY=2
# On Render, allow the Netlify site (and custom domain) to call the API:
# CORS_ORIGIN=https://your-site.netlify.app,https://your-domain.com
# Only needed on Netlify if you skip the /api proxy and call Render directly:
# VITE_API_URL=https://myportfolio-jv2c.onrender.com
